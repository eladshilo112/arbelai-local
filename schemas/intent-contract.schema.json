{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arbelai.org/schemas/intent-contract.schema.json",
  "title": "ARBELAI Intent Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "original_request",
    "original_request_hash",
    "workspace",
    "acceptance",
    "created_at"
  ],
  "properties": {
    "protocol_version": { "const": "0.1.0" },
    "original_request": { "type": "string", "minLength": 1 },
    "original_request_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workspace": { "type": "string", "minLength": 1 },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}