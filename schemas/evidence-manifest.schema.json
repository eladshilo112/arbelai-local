{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arbelai.org/schemas/evidence-manifest.schema.json",
  "title": "ARBELAI Evidence Manifest",
  "type": "object",
  "required": ["protocol_version", "content_mode", "budget_tokens", "estimated_tokens", "evidence", "manifest_hash"],
  "properties": {
    "protocol_version": { "const": "0.1.0" },
    "content_mode": { "enum": ["metadata_only", "targeted"] },
    "budget_tokens": { "type": "integer", "minimum": 0 },
    "estimated_tokens": { "type": "integer", "minimum": 0 },
    "inventory_total": { "type": "integer", "minimum": 0 },
    "inventory_considered": { "type": "integer", "minimum": 0 },
    "inventory_truncated": { "type": "boolean" },
    "scanned_bytes": { "type": "integer", "minimum": 0 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "hash", "provenance", "reason", "content_included"],
        "properties": {
          "path": { "type": "string" },
          "hash": { "type": "string" },
          "provenance": { "enum": ["PROJECT_UNTRUSTED", "WEB_UNTRUSTED", "USER_APPROVED", "SYSTEM_POLICY", "MODEL_GENERATED"] },
          "reason": { "type": "string" },
          "content_included": { "type": "boolean" }
        }
      }
    },
    "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}